# Скопіюйте цей файл у .env і заповніть.

# Токен і нік бота з @BotFather. Поки вони порожні, сайт працює в тестовому режимі входу.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# SMS-підтвердження номера при реєстрації (twilio.com). Поки порожньо — код показується на екрані (тестовий режим).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Номер або ім'я відправника, з якого Twilio надсилає SMS
TWILIO_FROM=

# Адреса сайту (для посилань у сповіщеннях Telegram)
SITE_URL=https://zapyt.biz

# 1 — якщо сайт працює через HTTPS (на бойовому сервері обов'язково)
COOKIE_SECURE=1

# Ніки адміністраторів через кому: можуть закривати й видаляти будь-які запити
ADMIN_USERNAMES=

HOST=127.0.0.1
PORT=8000
